    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Triangle -->
    <path
        android:fillColor="#FFD700"
        android:pathData="M12,2 L1,21 H23 Z" />

    <!-- Exclamation stem -->
    <path
        android:fillColor="#1A0000"
        android:pathData="M11,9 H13 L12.5,16 H11.5 Z" />

    <!-- Exclamation dot -->
    <path
        android:fillColor="#1A0000"
        android:pathData="M11.25,17.5 A0.75,0.75 0 1 0 12.75,17.5 A0.75,0.75 0 1 0 11.25,17.5 Z" />

